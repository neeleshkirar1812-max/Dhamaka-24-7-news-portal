# Database (SQLite for local dev, PostgreSQL for production)
# For PostgreSQL: postgresql://user:password@localhost:5432/dhamaka24x7_news?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Single Admin Account (seeded by prisma/seed.ts)
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL="admin@newsportal.in"
ADMIN_PASSWORD_HASH=""

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense
ADSENSE_CLIENT_ID=""

# Anthropic Claude AI (server-side only)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_DAILY_LIMIT="200"

# Media Storage ("local" | "cloudinary" | "s3")
STORAGE_PROVIDER="local"
