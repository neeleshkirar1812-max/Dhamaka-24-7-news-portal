# Database (SQLite for local dev, PostgreSQL for production)
# For PostgreSQL: postgresql://user:password@localhost:5432/dhamaka24x7_news?schema=public
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Single Admin Account (seeded by prisma/seed.ts)
# Generate hash with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_EMAIL="admin@newsportal.in"
ADMIN_PASSWORD_HASH=""

# Public Site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense
ADSENSE_CLIENT_ID=""

# AI Editorial Assistant (server-side only)
# Option 1 (Free Tier): Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Option 2 (Paid): Anthropic Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_PROVIDER="auto"
AI_DAILY_LIMIT="200"

# Media Storage ("local" | "cloudinary" | "s3")
STORAGE_PROVIDER="local"
